# ---- intel2doc POC configuration ----
# Copy to .env and adjust. NEVER commit real secrets.

# Which extraction engine to use:
#   mock   - offline, deterministic (no AI, no setup) -> great for demos
#   ollama - real vision AI via a local Ollama server (qwen2.5vl:3b)
EXTRACTOR=mock

# Confidence routing threshold (0-1). Fields/docs below this go to human review.
CONFIDENCE_THRESHOLD=0.80

# Database URL. Defaults to a local SQLite file for zero-setup.
DATABASE_URL=sqlite:///./storage/intel2doc.sqlite3

# Optional API key. Leave unset for open, zero-setup demos. When set, every
# non-health endpoint requires it via `Authorization: Bearer <key>` or `X-API-Key`.
# API_KEY=change-me

# Comma-separated allowed CORS origins. "*" is fine locally; lock down in prod.
CORS_ORIGINS=*

# ---- Ollama vision AI (only used when EXTRACTOR=ollama) ----
# Install Ollama, then: `ollama pull qwen2.5vl:3b`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# ---- Frontend (Vite) ----
# The API base the UI calls. Default matches the backend port below.
# VITE_API_BASE=http://localhost:8020

# ---- Legacy generic LLM path (optional, not used by default) ----
# LLM_PROVIDER=azure_openai
# LLM_API_KEY=__set_in_local_env_only__
# LLM_ENDPOINT=
# LLM_MODEL=gpt-4o
